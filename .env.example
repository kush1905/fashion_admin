# Browser-side API base (must include /api). Inlined at build time for client bundles.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Production example (set in Vercel → Project Settings → Environment Variables → Production):
# NEXT_PUBLIC_API_URL=https://reena-rathore-backend.onrender.com/api
#
# After changing NEXT_PUBLIC_* on Vercel, trigger a new deployment so the value is baked into the JS bundle.
